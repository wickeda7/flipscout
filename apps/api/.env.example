NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Phase 3 data source. Use "mock" for local demo data or "postgres" for PostgreSQL.
DATA_PROVIDER=mock

# Required when DATA_PROVIDER=postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flipscout
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Temporary development identity until authentication is added.
DEV_USER_ID=00000000-0000-0000-0000-000000000001

AUTH_SESSION_DAYS=30

# Local-only convenience. Set false to require authentication for user-owned resources.
ALLOW_DEV_AUTH_FALLBACK=true

PASSWORD_RESET_MINUTES=30
WEB_APP_URL=http://localhost:3000

EMAIL_VERIFICATION_HOURS=24


# Transactional email.
# Development defaults to console. Production defaults to resend.
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=FlipScout <noreply@example.com>

# Only enable behind a trusted reverse proxy/load balancer that overwrites
# X-Forwarded-For. Otherwise client IPs come from the socket directly.
TRUST_PROXY=false

# Retailer-feed freshness threshold used by /v1/ingestion/status.
INGESTION_STALE_AFTER_MINUTES=180

# Relative to apps/api when using root Yarn scripts. Operator-owned file.
RETAILER_SOURCES_FILE=config/retailer-sources.json
# Supply the real value through your environment or secret manager.
RETAILER_FEED_TOKEN=
