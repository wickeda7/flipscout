{
  "name": "@flipscout/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:bootstrap": "tsx scripts/bootstrap-db.ts",
    "db:check": "tsx scripts/check-db.ts",
    "ingest:retailer": "tsx scripts/ingest-retailer.ts",
    "test:connectors": "tsx --test tests/*.test.ts",
    "ingest:check": "tsx scripts/check-sources.ts",
    "ingest:due": "tsx scripts/ingest-retailer.ts --due",
    "test:postgres": "tsx --test tests/postgres.integration.ts"
  },
  "dependencies": {
    "@flipscout/types": "0.1.0",
    "@flipscout/core": "0.1.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "@types/pg": "^8.11.10"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
