{
  "name": "flipscout",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @flipscout/web",
    "dev:api": "npm run dev -w @flipscout/api",
    "build:web": "npm run build -w @flipscout/web",
    "typecheck:api": "npm run typecheck -w @flipscout/api",
    "db:bootstrap": "yarn workspace @flipscout/api db:bootstrap",
    "db:check": "yarn workspace @flipscout/api db:check",
    "ingest:retailer": "yarn workspace @flipscout/api ingest:retailer"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "yarn@1.22.22"
}
